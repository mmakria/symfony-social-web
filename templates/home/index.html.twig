{% extends 'base.html.twig' %}



{% block body %}
    <h2>Last 3 blogs added</h2>

    <section class="bg-white rounded-2xl shadow-lg overflow-hidden flex flex-row justify-around gap-6 p-6">

            {% for post in lastPosts %}

                <article class="">
                <div class="text-2xl font-bold mb-2">
                    {{ post.title }}
                </div>
                <p class="text-gray-600 mb-4">
                    {{ post.text }}
                </p>
                <a href="{{ path('app_micro_post_show', {post: post.id}) }}" class="text-blue-500 hover:underline font-semibold">Lire l'article</a>
                </article>
            {% endfor %}

    </section>



{% endblock %}